# Example Terraform variables
# Copy this file to terraform.tfvars and customize

# AWS Configuration
aws_region   = "us-west-2"
environment  = "dev"
project_name = "workflows"

# EKS Configuration (required for IRSA)
eks_cluster_name         = "workflows-prod"
eks_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/oidc.eks.us-west-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B716D3041E"
eks_namespace            = "workflows"
eks_service_account_name = "workflows-sa"

# Feature Flags
enable_cognito   = true
enable_scheduler = true

# EventBridge Scheduler callback delivery
# The app creates/updates/deletes schedules in the scheduler group.
# Each schedule should target the EventBridge event bus output by Terraform;
# EventBridge then invokes this HTTPS API destination with the configured credentials.
scheduler_api_destination_endpoint      = "https://workflows-us-west-2.example.com/api/scheduler/callback"
scheduler_api_destination_http_method   = "POST"
scheduler_api_destination_auth_type     = "API_KEY"
scheduler_api_destination_api_key_name  = "x-api-key"
scheduler_api_destination_api_key_value = "replace-with-a-strong-shared-secret"
# For basic auth instead:
# scheduler_api_destination_auth_type      = "BASIC"
# scheduler_api_destination_basic_username = "scheduler"
# scheduler_api_destination_basic_password = "replace-with-a-strong-password"
# For OAuth client credentials instead:
# scheduler_api_destination_auth_type                    = "OAUTH_CLIENT_CREDENTIALS"
# scheduler_api_destination_oauth_authorization_endpoint = "https://auth.example.com/oauth2/token"
# scheduler_api_destination_oauth_http_method            = "POST"
# scheduler_api_destination_oauth_client_id              = "workflows-scheduler"
# scheduler_api_destination_oauth_client_secret          = "replace-with-client-secret"
# scheduler_api_destination_oauth_http_parameters = {
#   body = [
#     {
#       key   = "grant_type"
#       value = "client_credentials"
#     }
#     # Add a scope parameter here if your authorization server requires it.
#   ]
# }

# Cognito URLs
cognito_callback_urls = [
  "http://localhost:3000/auth/callback",
  "https://workflows-us-west-2.example.com/auth/callback"
]
cognito_logout_urls = [
  "http://localhost:3000",
  "https://workflows-us-west-2.example.com"
]

# S3 Configuration
s3_force_destroy                      = false  # Set to true for dev environments
s3_versioning_enabled                 = true
s3_noncurrent_version_expiration_days = 90

# ============================================
# Existing Resources (Optional)
# ============================================
# If you have existing S3 buckets or KMS keys, specify them here.
# Leave empty (default) to create new resources.

# Existing KMS Key
# existing_kms_key_arn = "arn:aws:kms:us-west-2:123456789012:key/12345678-1234-1234-1234-123456789012"

# Existing S3 Buckets
# existing_user_files_bucket        = "my-existing-user-files-bucket"
# existing_documents_bucket         = "my-existing-documents-bucket"
# existing_tenant_migrations_bucket = "my-existing-migrations-bucket"
